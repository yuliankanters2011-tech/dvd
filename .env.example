# Kopieer naar .env of laat scripts/prepare-host.sh dit bestand maken.
# De gedeelde map moet in DSM bestaan (Configuratiescherm > Gedeelde map).
SHARE_PATH=/volume1/dvd
DEVICE=/dev/sr0
WEB_PORT=8080
WEB_BIND=0.0.0.0
PUID=1024
PGID=100
POLL_SECONDS=5
COPY_FILES=false
# Uitwerpen na geslaagde automatische kopie of live-dvd-conversie:
AUTO_EJECT=false
# Een beetje onleesbare data (percentage) mag automatisch in de ISO blijven.
# Bij meer schade vraagt het dashboard eerst om 'Toch doorgaan'.
ISO_MAX_MISSING_PERCENT=0.5
# Standaard GitHub Container Registry. Voor Docker Hub:
# IMAGE_NAME=docker.io/<jouw-dockerhub-gebruikersnaam>/dvd-bridge
IMAGE_NAME=ghcr.io/yuliankanters2011-tech/dvd
IMAGE_TAG=latest
# Jellyfin-bestemmingen op de NAS (hostpaden):
FILMS_PATH=/volume1/video/Films
MUSIC_PATH=/volume1/video/Muziek
# Converter (FFmpeg):
CONVERT_THREADS=2
CONVERT_CRF=20
CONVERT_PRESET=veryfast
CONVERT_AUDIO_BITRATE=192
# Slaapstand: 0 = uit, anders 60 t/m 86400 seconden zonder opdracht/activiteit.
# De usb-voeding blijft aan; het stopcommando is best-effort.
SLEEP_IDLE_SECONDS=600
# Draaisnelheid aanvragen: 0 = standaard/maximum, 1 t/m 24 Linux cdrom-eenheden.
# Niet elke speler/usb-brug ondersteunt dit; het is geen gemeten RPM.
DRIVE_SPEED=0